{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModelMix",
  "version": "0.1.0",
  "identifier": "com.blackanvil.modelmix",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173/modelmix",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ModelMix",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../dist/modelmix-backend/"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
